# Caddy obtains and renews the HTTPS certificate for $DOMAIN automatically (Let's Encrypt).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:8000 {
		transport http {
			read_timeout 10m
		}
	}
	# Optional password protection: generate a hash with
	#   docker compose run --rm caddy caddy hash-password --plaintext 'your-password'
	# then uncomment and paste it here.
	# basic_auth {
	#	admin <hash>
	# }
}
